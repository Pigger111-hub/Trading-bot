  "conclusions_th": [
    "ตรวจข้อมูลผลจริงที่บันทึกไว้ครบ 4 ชุดพารามิเตอร์ รวม development และ 3 folds จำนวน 16 ผล โดยตรวจ hash ของ registry และผลลัพธ์ทุกไฟล์ก่อนใช้งาน",
    "สัญญาณซื้อและปิดสถานะที่บันทึกไว้จับคู่กับรายการซื้อขายหรือสถานะปลายงวดได้แบบหนึ่งต่อหนึ่ง ตรวจขนาด BTC ระดับ 1 satoshi และค่าธรรมเนียมเข้า/ออกโดยไม่คิดซ้ำ รวมทั้งกระทบยอด equity ทุกจุด",
    "ผล stress ต้นทุนสองเท่าตรวจได้เพียงตัวเลขสรุป development เพราะไม่ได้บันทึกสมุดรายการและเส้น equity แบบเต็ม จึงไม่รับรองรายละเอียด fill หรือค่าธรรมเนียมรายรายการของ stress",
    "ไม่มีการรัน backtest เพิ่ม ไม่มีการเปลี่ยน source/registry/ข้อมูล/ข้อกำหนดความเสี่ยง และผลนี้ไม่ใช่การยืนยันกำไรจริงหรือการอนุมัติ paper/live"
  ],
  "cost_formulas": {
    "curve_equity": "10000 + realized net PnL through current candle + active gross mark PnL - active entry fees",
    "entry_fee": "BTC_size * entry_price * 0.001, paid once on open",
    "entry_price": "raw_next_open * (1 + 0.0005)",
    "exit_fee": "BTC_size * exit_price * 0.001, paid once on realized close",
    "exit_price": "raw_next_open (no second spread)",
    "realized_net_pnl": "BTC_size * (exit_price - entry_price) - entry_fee - exit_fee",
    "terminal_equity": "10000 + sum(realized net PnL) + sum(terminal net mark PnL)",
    "terminal_net_mark_pnl": "BTC_size * (last_close - entry_price) - entry_fee; no exit fee"
  },
